# Copy to .env and adjust. .env is gitignored; this file is the committed template.

# Which inference provider the app uses: mock | tflite | remote
# Defaults to `tflite` when unset — on-device is the production path.
# - tflite: on-device model. THE PRIMARY PATH. Needs the model packaged into
#           the build (MODEL_SOURCE in src/inference/modelConfig.ts), which is
#           settled at the EAS build step; until then it fails loudly with
#           "model not available on this build" rather than pretending.
# - mock:   deterministic dev-only provider, for working on the UI without the
#           model. The app refuses to ship with it.
# - remote: FastAPI debug fallback (see server/README.md).
EXPO_PUBLIC_INFERENCE_PROVIDER=mock

# Required only when EXPO_PUBLIC_INFERENCE_PROVIDER=remote.
# Example: http://192.168.0.10:8000
EXPO_PUBLIC_REMOTE_API_URL=

# Firebase Auth (OPTIONAL — account features only).
# Scanning, history, the library and PDF reports all work without these:
# auth is never on the critical path to a diagnosis. Set all four or none.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
