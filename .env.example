# Copy to .env and adjust. .env is gitignored; this file is the committed template.

# NOTE: .env NEVER reaches an EAS build — .easignore excludes it, so a release
# APK sees none of these. Anything a build must know lives in src/config/env.ts
# as a committed constant. This file is for local development only.

# Which inference provider the app uses: mock | remote | tflite
# Defaults to `remote` when unset — server-backed is the shipping path.
# - remote: THE SHIPPING PATH. The FastAPI server, deployed as a Hugging Face
#           Space (deploy/huggingface/DEPLOY.md). The URL comes from
#           DEFAULT_REMOTE_API_URL in src/config/env.ts; the variable below only
#           overrides it locally, e.g. to point at a server on your own machine.
# - mock:   deterministic dev-only provider, for working on the UI with no
#           server. The app refuses to ship with it.
# - tflite: on-device. CURRENTLY UNUSABLE — the delivered model was exported
#           with TF Select (Flex) operators that no on-device TFLite runtime can
#           resolve. It fails loudly with `model-incompatible` rather than
#           pretending. See CLAUDE.md §4.
EXPO_PUBLIC_INFERENCE_PROVIDER=mock

# Optional local override of DEFAULT_REMOTE_API_URL, for pointing the app at a
# server running on your own machine. Example: http://192.168.0.10:8000
EXPO_PUBLIC_REMOTE_API_URL=

# Firebase Auth (OPTIONAL — account features only).
# Scanning, history, the library and PDF reports all work without these:
# auth is never on the critical path to a diagnosis. Set all four or none.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
