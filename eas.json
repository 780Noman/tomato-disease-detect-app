{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "localtest": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_INFERENCE_PROVIDER": "remote",
        "EXPO_PUBLIC_REMOTE_API_URL": "http://192.168.0.105:8010"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
