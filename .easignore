# EAS Build reads THIS instead of .gitignore when deciding what to upload.
# It therefore has to repeat the .gitignore rules, with one deliberate
# exception at the bottom: the on-device model, which is gitignored (141 MB)
# but MUST reach the build server or Metro cannot bundle it.

node_modules/
.expo/
dist/
web-build/
coverage/
*.log

# Never upload local env values. EAS supplies env vars itself, and a local
# .env selecting the mock provider would break the release build — the mock
# deliberately refuses to run outside development.
.env
.env.*
!.env.example

# The Python debug server plays no part in a mobile build.
server/

# Training dataset: never needed to build the app.
Balance DataSet Without Healthy Class/
Balance DataSet Without Healthy Class.zip

# Other model artefacts stay out.
*.keras
*.h5
docs/model/

# Model: never uploaded. The delivered .tflite cannot run on-device (800+ TF
# Select/Flex operators — see CLAUDE.md §4), so bundling it added ~141 MB to
# every APK, and ~8 minutes of upload per build, for a path that always fails.
# src/inference/modelConfig.ts has no asset require, so nothing needs it.
# When a builtins-only model exists, re-include it here and follow the steps in
# modelConfig.ts.
*.tflite

# Expo / native / OS noise
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
*.tsbuildinfo
/ios
/android
.DS_Store
Thumbs.db
*.pem
__pycache__/
*.pyc
.pytest_cache/

# Assembled Hugging Face Space folder (generated by npm run space:prepare).
# The sources are deploy/huggingface/ and server/app/ — this is a build output.
.hf-space/
