{
  "expo": {
    "name": "Tomato Leaf Doctor",
    "slug": "tomato-leaf-doctor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "tomatoleafdoctor",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tomatoleafdoctor.app"
    },
    "android": {
      "package": "com.tomatoleafdoctor.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6F1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Tomato Leaf Doctor uses the camera to photograph a single detached tomato leaf for diagnosis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tomato Leaf Doctor reads photos you select so an existing leaf picture can be diagnosed."
        }
      ],
      "react-native-fast-tflite"
    ]
  }
}
